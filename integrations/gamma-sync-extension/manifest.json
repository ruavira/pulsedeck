{
  "manifest_version": 3,
  "name": "PulseDeck Gamma Sync",
  "version": "0.2.0",
  "description": "Keeps PulseDeck aligned with Gamma and overlays live interactions on mapped activity cards.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://gamma.app/*",
    "https://pulsedeck-live.netlify.app/*",
    "https://pulsedeck.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PulseDeck Gamma Sync",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://gamma.app/docs/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
