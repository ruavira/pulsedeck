{
  "manifest_version": 3,
  "name": "PulseDeck Gamma Sync",
  "version": "0.3.0",
  "minimum_chrome_version": "102",
  "description": "Reliably keeps PulseDeck aligned with Gamma and presents verified live interactions in place.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://gamma.app/*",
    "https://pulsedeck-live.netlify.app/*",
    "https://pulsedeck.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PulseDeck Gamma Sync",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://gamma.app/docs/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
